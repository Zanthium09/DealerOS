# Copy to .env for local development.
#
# PRODUCTION MUST SET EVERY SECRET BELOW EXPLICITLY. Two independent checks enforce
# this, and the process fails to start rather than signing sessions or encrypting
# MFA secrets with a value that is in this file:
#   1. NODE_ENV=production refuses the dev fallbacks outright.
#   2. Without ALLOW_DEV_SECRETS=1 the fallbacks are refused whatever NODE_ENV says,
#      so a deploy that simply forgets NODE_ENV still fails closed.
# ALLOW_DEV_SECRETS=1 also logs a loud warning at boot. NEVER set it in production.

# Postgres (docker-compose reads these too)
POSTGRES_USER=dealeros
POSTGRES_PASSWORD=dealeros
POSTGRES_DB=dealeros
POSTGRES_PORT=5433

# Two roles, on purpose (finding 6). The API, the seed and every runtime connection
# use dealeros_app: not the table owner, not a superuser, so the append-only triggers
# on AuditEvent and ConsentLog cannot be disabled or dropped from it, and it holds no
# UPDATE/DELETE/TRUNCATE on those two tables at all. Connecting as the owner made
# those triggers — and any future Postgres RLS (1.3) — decoration.
DATABASE_URL="postgresql://dealeros_app:dealeros_app@localhost:5433/dealeros?schema=public"

# Owner/DDL role. Used ONLY by `pnpm prisma:migrate` / `pnpm prisma:deploy`, never by
# the running API. The dealeros_app role is created by the migration itself, so local
# setup stays one `docker compose up -d`. In production create dealeros_app yourself,
# with a real password, before the first deploy.
MIGRATE_DATABASE_URL="postgresql://dealeros:dealeros@localhost:5433/dealeros?schema=public"

# Test database. `pnpm test` creates a throwaway copy of this database per run
# (name + a run stamp), migrates it, runs the suite and drops it. It must NOT be
# DATABASE_URL, and its database name must contain "test" — the runner refuses
# otherwise, so a stray environment cannot point the suite at real data.
# Owner credentials: the runner has to CREATE and DROP the throwaway database and
# run the migrations on it. The suite's own app-role checks connect as dealeros_app
# explicitly (test/audit/db-role.test.ts).
TEST_DATABASE_URL="postgresql://dealeros:dealeros@localhost:5433/dealeros_test?schema=public"

# Redis
REDIS_PORT=6380
REDIS_URL="redis://localhost:6380"

# API
PORT=3001

# --- Auth (§9A) -------------------------------------------------------------
# Two separate flows, two separate secrets. They MUST differ: a token from one
# flow being unverifiable by the other is the structural guarantee behind §10.8.
# >= 32 characters each. Generate with: openssl rand -base64 48
AUTH_SESSION_SECRET="dev-only-tenant-session-secret-change-me-000000"
ADMIN_SESSION_SECRET="dev-only-platform-session-secret-change-me-0000"

# Encrypts each platform admin's TOTP secret at rest (AES-256-GCM). Losing it
# means every admin re-enrols; leaking it plus a database dump means every
# admin's second factor is forgeable. Keep it out of the database backup path.
# >= 32 characters.
ADMIN_MFA_KEY="dev-only-admin-mfa-encryption-key-change-me-000"

# Login rate limits (per process, per ACCOUNT, 60s window; requests carrying no
# email fall back to one shared per-IP bucket). Optional; defaults 10 / 5.
# Keyed on the account, not req.ip: behind a load balancer req.ip is the balancer
# for every request, so an IP-keyed bucket is one bucket for the whole platform and
# six anonymous POSTs would 429 every real operator indefinitely.
AUTH_LOGIN_MAX_ATTEMPTS=10
ADMIN_LOGIN_MAX_ATTEMPTS=5

# --- Seed (pnpm db:seed, local dev only) ------------------------------------
SEED_ORG_SLUG=dev-distributors
SEED_ORG_NAME="Dev Distributors"
SEED_USER_EMAIL=owner@dev.local
SEED_USER_PASSWORD=dev-password-change-me
SEED_ADMIN_EMAIL=admin@dev.local
SEED_ADMIN_PASSWORD=dev-password-change-me

# Local dev only. Without this, missing secrets throw instead of falling back; with
# NODE_ENV=production they throw regardless. It is also the single switch that drops
# the `Secure` flag from the session cookies — NEVER set this in production.
ALLOW_DEV_SECRETS=1

# apps/web dev server origin, for CORS on the API (main.ts). Comma-separated if
# more than one. Defaults to http://localhost:3000 if unset.
WEB_ORIGIN=http://localhost:3000
