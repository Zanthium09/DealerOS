// DealerOS — §11 step 1 foundation tables only.
// Organization, User, AdminUser, Dealer, ConsentLog, AuditEvent. Nothing else yet.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm powers M1's fuzzy businessName + city match (§2, §5.1).
  extensions = [pg_trgm]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  OFFICE_STAFF
  SALESMAN
  // No cross-org value here, ever (§1.9). Platform access lives on AdminUser.
}

enum AdminRole {
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
}

enum DealerSource {
  IMPORTED_LIST
  TRADE_FAIR
  INQUIRY
  REFERRAL
  MANUAL
  DISCOVERED
}

enum PipelineStage {
  NEW
  CONTACTED
  INTERESTED
  ONBOARDED
  ACTIVE
  DORMANT
  REACTIVATED
  // terminal
  OPTED_OUT
  INVALID
}

enum ConsentChannel {
  EMAIL
  WHATSAPP
  CALL
}

enum ConsentState {
  OPTED_IN
  OPTED_OUT
  UNKNOWN
}

enum ConsentSource {
  EXPLICIT_UNSUBSCRIBE
  BOUNCE
  IMPORT_DEFAULT
  VERBAL
  INBOUND_MESSAGE
}

enum EmailVerificationStatus {
  UNVERIFIED
  VALID
  INVALID
  RISKY
}

enum ActorType {
  USER
  SYSTEM
  ADMIN // §9A.3 — admin views of tenant data are audited
}

// ---------------------------------------------------------------------------
// Tables
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  dealers             Dealer[]
  consentLogs         ConsentLog[]
  auditEvents         AuditEvent[]
  dealerPhones        DealerPhone[]
  dealerEmails        DealerEmail[]
  messageDrafts       MessageDraft[]
  importBatches       ImportBatch[]
  duplicateCandidates DuplicateCandidate[]
  dealerMerges        DealerMerge[]
  interactionEvents   InteractionEvent[]
  sendingIdentities   SendingIdentity[]
  suppressions        Suppression[]
  campaigns           Campaign[]
  outreachSchedules   OutreachSchedule[]
  outreachTemplates   OutreachTemplate[]
  outreachSettings    OutreachSettings?
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  name           String?
  passwordHash   String?
  role           UserRole
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  assignedDealers Dealer[]     @relation("AssignedSalesman")

  // Email is unique per org, not globally — the same person may exist in two tenants.
  @@unique([organizationId, email])
  // §1.3, belt and braces: the target of every composite (organizationId, id) foreign
  // key below. It is what makes a cross-org `connect` a foreign-key violation in the
  // database, where an application layer cannot forget it.
  @@unique([organizationId, id])
  @@index([organizationId])
}

// Platform operators. NO organizationId — deliberate (§4, §9A).
// Separate table, separate login route (/admin/auth/*), separate session type.
model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  role          AdminRole
  mfaEnabled    Boolean   @default(false)
  // Per-admin TOTP secret, AES-256-GCM encrypted at rest with a key derived from
  // ADMIN_MFA_KEY (core/platform-admin/totp.ts). Stored rather than derived so one
  // admin's factor can be rotated without resetting everyone's, and so a database
  // dump alone yields no working second factors.
  mfaSecret     String?
  // Last TOTP step this admin has spent (finding 11). The replay guard used to be a
  // module-level Map: a deploy or crash inside a code's 90-second window reopened it,
  // and a second API replica never shared it. On the row it survives both.
  mfaLastStep   Int?
  mfaEnrolledAt DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
}

model Dealer {
  id                String  @id @default(cuid())
  organizationId    String
  businessName      String
  contactPersonName String?
  // Internal-only, never sent to a dealer or read by drafting — a rep's own notes.
  // No §1.4 concern: this text never becomes part of an outbound message.
  notes             String?

  region           String?
  city             String?
  state            String?
  businessCategory String?

  source        DealerSource
  pipelineStage PipelineStage @default(NEW)

  assignedSalesmanId String?
  dedupeKey          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id])
  // Composite on purpose (§1.3): a salesman can only ever be a user of THIS dealer's
  // org, enforced by the foreign key, not by remembering to filter.
  assignedSalesman    User?                @relation("AssignedSalesman", fields: [organizationId, assignedSalesmanId], references: [organizationId, id], onUpdate: Restrict)
  consentLogs         ConsentLog[]
  phones              DealerPhone[]
  emails              DealerEmail[]
  messageDrafts       MessageDraft[]
  duplicateCandidates DuplicateCandidate[]
  mergesAsSurvivor    DealerMerge[]        @relation("MergeSurvivor")
  mergesAsMerged      DealerMerge[]        @relation("MergeMerged")
  interactionEvents   InteractionEvent[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, pipelineStage])
  @@index([organizationId, dedupeKey])
}

// Split out of Dealer rather than stored as Json: §5.1 dedup matches on exact phoneE164
// as its highest-priority rule, which needs a real index. organizationId is carried here
// too so the tenancy guard (§1.3) can scope it like every other table.
model DealerPhone {
  id             String  @id @default(cuid())
  organizationId String
  dealerId       String
  raw            String
  e164           String?
  valid          Boolean @default(false)
  isPrimary      Boolean @default(false)
  isWhatsapp     Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id])
  dealer       Dealer       @relation(fields: [organizationId, dealerId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId])
  @@index([organizationId, e164])
  @@index([dealerId])
}

model DealerEmail {
  id                 String                  @id @default(cuid())
  organizationId     String
  dealerId           String
  address            String
  verificationStatus EmailVerificationStatus @default(UNVERIFIED)
  isPrimary          Boolean                 @default(false)

  organization Organization @relation(fields: [organizationId], references: [id])
  dealer       Dealer       @relation(fields: [organizationId, dealerId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId])
  @@index([organizationId, address])
  @@index([dealerId])
}

// APPEND-ONLY. Never updated, never deleted — this is the DPDP audit trail (§1.6, §4).
// Current consent = most recent row per (dealerId, channel). Channels are independent:
// an email opt-out must never suppress WhatsApp.
model ConsentLog {
  id             String         @id @default(cuid())
  organizationId String
  dealerId       String
  channel        ConsentChannel
  state          ConsentState
  source         ConsentSource
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  dealer       Dealer       @relation(fields: [organizationId, dealerId], references: [organizationId, id], onUpdate: Restrict)

  @@index([organizationId])
  @@index([dealerId, channel, createdAt])
}

// Immutable (§4).
model AuditEvent {
  // Nullable: a platform-wide admin action (§9A.3) belongs to no single org.
  // For VIEWED_ORG_DATA this is the org whose data was viewed.
  organizationId String?
  id             String    @id @default(cuid())
  actorType      ActorType
  actorId        String?
  entityType     String
  entityId       String
  action         String
  metadata       Json?
  createdAt      DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}

// ---------------------------------------------------------------------------
// §11 step 2 — Approval Queue + drafting, and M1 import/dedup (§5.1)
// Relations to Dealer are composite (organizationId, id) like every other
// child table, so a cross-org reference is a foreign-key violation (§1.3).
// ---------------------------------------------------------------------------

enum DraftStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_SENT
  EDITED_AND_SENT
}

// The AI output boundary (§1.4, §1.5). Every AI-generated outbound message
// passes through here before it can become an InteractionEvent.
model MessageDraft {
  id             String @id @default(cuid())
  organizationId String
  dealerId       String
  sourceModule   String

  subject                String   @default("")
  draftText              String
  bodyHtml               String?
  // Free-form extra recipients, set when a human composes a one-off message.
  ccEmails               String[] @default([])
  bccEmails              String[] @default([])
  // §1.4: the DB-sourced numbers, injected as typed variables. The model never
  // sees a free-text slot where a number could be invented.
  templateVariables      Json     @default("{}")
  containsFinancialTerms Boolean  @default(false)
  requiresApproval       Boolean  @default(true)

  status           DraftStatus @default(PENDING)
  approvedByUserId String?
  autoSendRuleId   String?
  sentAt           DateTime?
  // Why the last send attempt failed, and how many have been tried. An APPROVED
  // draft with a lastSendError is the retry queue — before this existed a failed
  // send left the row APPROVED and indistinguishable from one awaiting dispatch,
  // so nothing could ever retry it.
  lastSendError    String?
  sendAttempts     Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  dealer       Dealer       @relation(fields: [organizationId, dealerId], references: [organizationId, id], onUpdate: Restrict)

  @@index([organizationId, status])
  @@index([organizationId, dealerId])
}

enum ImportStatus {
  MAPPING
  PROCESSING
  COMPLETED
  FAILED
}

// §5.1 — `source` is mandatory per import batch, so it lives here, not per row.
model ImportBatch {
  id             String       @id @default(cuid())
  organizationId String
  filename       String
  source         DealerSource
  columnMapping  Json         @default("{}")
  status         ImportStatus @default(MAPPING)

  rowCount       Int @default(0)
  createdCount   Int @default(0)
  duplicateCount Int @default(0)
  invalidCount   Int @default(0)

  createdByUserId String?
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?
  error           String?

  organization Organization         @relation(fields: [organizationId], references: [id])
  candidates   DuplicateCandidate[]

  // Every child relation in this file is composite (organizationId, id) so that a
  // cross-org reference is a foreign-key violation (§1.3). This unique is what lets
  // DuplicateCandidate.importBatch be one too.
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
}

enum MatchReason {
  PHONE_E164
  EMAIL
  FUZZY_NAME_CITY
}

enum CandidateStatus {
  PENDING
  MERGED
  REJECTED
}

// §5.1/§10.1: fuzzy matches are NEVER auto-merged. They land here for a human.
model DuplicateCandidate {
  id              String  @id @default(cuid())
  organizationId  String
  importBatchId   String?
  matchedDealerId String

  incomingPayload Json
  matchReason     MatchReason
  matchScore      Float?
  status          CandidateStatus @default(PENDING)

  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id])
  matchedDealer Dealer       @relation(fields: [organizationId, matchedDealerId], references: [organizationId, id], onUpdate: Restrict)
  importBatch   ImportBatch? @relation(fields: [organizationId, importBatchId], references: [organizationId, id], onUpdate: Restrict)

  @@index([organizationId, status])
}

// §5.1/§10.1: "merges are logged as reversible operations". `snapshot` holds
// enough of the merged dealer to put it back; a wrong merge silently corrupts
// two businesses' order and payment history, so reversal is not optional.
model DealerMerge {
  id                String @id @default(cuid())
  organizationId    String
  survivingDealerId String
  mergedDealerId    String

  snapshot        Json
  reversedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id])
  // Composite like every other dealer reference: the last place a dealer id could
  // live without a database-level org check (§1.3). Both dealers survive a merge —
  // the merged one is parked at INVALID, never deleted — so an FK is safe here.
  survivingDealer Dealer       @relation("MergeSurvivor", fields: [organizationId, survivingDealerId], references: [organizationId, id], onUpdate: Restrict)
  mergedDealer    Dealer       @relation("MergeMerged", fields: [organizationId, mergedDealerId], references: [organizationId, id], onUpdate: Restrict)

  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// §11 step 3 — InteractionEvent + webhook ingestion, and M2's sending tables
// ---------------------------------------------------------------------------

enum InteractionDirection {
  OUTBOUND
  INBOUND
}

enum InteractionStatus {
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  FAILED
  COMPLAINED
}

// Every touch, every channel, one table (§4). This is what makes warm-routing
// (§7) a real query filter rather than a manual export.
model InteractionEvent {
  id             String @id @default(cuid())
  organizationId String
  dealerId       String

  channel   ConsentChannel
  direction InteractionDirection

  campaignId        String?
  messageDraftId    String?
  providerMessageId String?

  status    InteractionStatus
  // The rendered text actually sent — you must be able to answer
  // "what exactly did we send this dealer?" (§4). Subject is part of that answer.
  subject   String            @default("")
  body      String
  toAddress String            @default("")
  // Provider/transport failure text for a FAILED row, so the Sent view can say why
  // instead of showing a bare red badge.
  errorText String?
  createdAt DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  dealer       Dealer       @relation(fields: [organizationId, dealerId], references: [organizationId, id], onUpdate: Restrict)

  @@index([organizationId, dealerId, createdAt])
  @@index([organizationId, providerMessageId])
}

enum DomainVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

// §6: never the org's primary business domain. Warmup ramp is per identity.
model SendingIdentity {
  id                 String                   @id @default(cuid())
  organizationId     String
  domain             String
  provider           String
  // Who the mail appears to come from: `"<fromName>" <fromLocalPart@domain>`.
  // Both were hardcoded ("sales@" + no display name) — a real person's name in
  // the From line measurably outperforms a role address on cold outreach.
  fromName           String                   @default("")
  fromLocalPart      String                   @default("sales")
  replyToAddress     String?
  verificationStatus DomainVerificationStatus @default(UNVERIFIED)
  dkimRecords        Json                     @default("[]")
  warmupStartedAt    DateTime?
  currentDailyLimit  Int                      @default(20)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, domain])
  @@index([organizationId])
}

// §4: scoped per organization. An opt-out from one distributor must not
// suppress that contact for another.
model Suppression {
  id             String   @id @default(cuid())
  organizationId String
  email          String?
  phoneE164      String?
  reason         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, email])
  @@index([organizationId, phoneE164])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  channel        ConsentChannel
  name           String
  status         CampaignStatus @default(DRAFT)
  segmentFilter  Json           @default("{}")
  templateId     String?
  scheduledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
}

// §8 idempotency. Deliberately has NO organizationId: a webhook is received
// before any org context exists, and the HTTP handler only persists and
// enqueues. The org is resolved during async processing, and the
// InteractionEvent that results IS org-scoped. Must be listed explicitly in
// tenancy.ts's exemptions — never inferred from the absent column.
model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  error           String?

  @@unique([provider, providerEventId])
  @@index([processedAt])
}

// ---------------------------------------------------------------------------
// Cold-outreach scheduling and batching (§5.2 extension). Multiple schedules per
// org allowed — e.g. one segment daily, another weekly. Each is a BullMQ repeatable
// job under the hood; this table is the durable record the job registration is
// rebuilt from at boot (BullMQ's own repeat registry does not survive a Redis flush,
// this table does).
// ---------------------------------------------------------------------------
model OutreachSchedule {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  enabled        Boolean @default(true)

  // Exactly one of these two is set — enforced in schedule.service.ts, not a DB
  // constraint (matches how "source is mandatory" etc. are enforced elsewhere in
  // this codebase: at the service layer, not fought into Prisma's migration DSL).
  //   cronExpression set  -> recurring (BullMQ repeatable job)
  //   scheduledAt set     -> exactly once, at that moment (BullMQ delayed job)
  // Standard 5-field cron ("0 9 * * *" = daily at 9am). Validated by BullMQ at
  // registration time, not re-validated here — one parser, not two.
  cronExpression String?
  scheduledAt    DateTime?

  // Caps this run the same way a manual "send N now" would (see runColdOutreach).
  // Null = no extra cap beyond the daily send limit already enforced (§6).
  maxDealersPerRun Int?

  // Same shape as the manual run's segment filter — city/state/businessCategory/
  // source/pipelineStage. {} = every eligible NEW dealer, matching today's default.
  segmentFilter Json @default("{}")

  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastRunAt       DateTime?
  // Set when the firing that produced lastRunAt failed (e.g. no sending identity,
  // no API key configured), cleared on a successful firing. Without this a failed
  // one-time schedule looked identical to one that had never run — BullMQ itself
  // does not retry by default, so a failed firing is otherwise a silent dead end.
  lastError       String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Editable cold-outreach wording. Exactly one active row per org — cold-draft.service
// falls back to its own hardcoded default when none exists, so this table being empty
// is a valid, safe state, not an error. bodyText is validated through the same
// template()/assertNoDigits path (§1.4) as the hardcoded default before it is ever
// saved — a business owner editing wording is not a loophole for a free-typed number
// any more than a hand-written skeleton in code is.
// ---------------------------------------------------------------------------
model OutreachTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  // The subject line. Was hardcoded to one string for every email the app ever
  // sent, which is both unusable and the single strongest spam signal a cold
  // sender can emit. Supports the same {{placeholders}} the body does.
  subject        String   @default("")
  bodyText       String
  // Optional HTML alternative. Null = send text only, which is what cold outreach
  // generally should do anyway (a plain-looking first-touch mail lands better).
  bodyHtml       String?
  // false = render this template deterministically and never show it to the model.
  // §1.4 is satisfied trivially in that mode (the AI writes nothing at all), which
  // is what lets a human-authored template contain literal digits — "24x7",
  // "Since 1995", a GST number — that the AI path must still refuse to emit.
  useAi          Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

/**
 * Per-organization outbound settings (§12.6, §6). One row per org.
 * `throttleEnabled = false` means "do not impose an application-level cap" — the
 * only remaining limits are the provider's own, enforced by paced dispatch rather
 * than a daily ceiling. The warmup ramp is likewise opt-out: it protects a brand
 * new domain, but an org sending from an already-warm domain should not be held
 * to 20/day because this app assumed it must be new.
 */
model OutreachSettings {
  id             String @id @default(cuid())
  organizationId String @unique

  throttleEnabled   Boolean @default(true)
  warmupEnabled     Boolean @default(true)
  /**
   * Applies only while throttleEnabled. 0 = unlimited.
   */
  dailyLimit        Int     @default(50)
  /**
   * Paced dispatch, always applied — this is the provider's rate limit, not ours.
   * Resend allows 2 requests/second; 500ms keeps us just inside it.
   */
  minSendIntervalMs Int     @default(500)

  emailPaused Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}
