// DealerOS — §11 step 1 foundation tables only.
// Organization, User, AdminUser, Dealer, ConsentLog, AuditEvent. Nothing else yet.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm powers M1's fuzzy businessName + city match (§2, §5.1).
  extensions = [pg_trgm]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  OFFICE_STAFF
  SALESMAN
  // No cross-org value here, ever (§1.9). Platform access lives on AdminUser.
}

enum AdminRole {
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
}

enum DealerSource {
  IMPORTED_LIST
  TRADE_FAIR
  INQUIRY
  REFERRAL
  MANUAL
  DISCOVERED
}

enum PipelineStage {
  NEW
  CONTACTED
  INTERESTED
  ONBOARDED
  ACTIVE
  DORMANT
  REACTIVATED
  // terminal
  OPTED_OUT
  INVALID
}

enum ConsentChannel {
  EMAIL
  WHATSAPP
  CALL
}

enum ConsentState {
  OPTED_IN
  OPTED_OUT
  UNKNOWN
}

enum ConsentSource {
  EXPLICIT_UNSUBSCRIBE
  BOUNCE
  IMPORT_DEFAULT
  VERBAL
  INBOUND_MESSAGE
}

enum EmailVerificationStatus {
  UNVERIFIED
  VALID
  INVALID
  RISKY
}

enum ActorType {
  USER
  SYSTEM
  ADMIN // §9A.3 — admin views of tenant data are audited
}

// ---------------------------------------------------------------------------
// Tables
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  dealers               Dealer[]
  consentLogs           ConsentLog[]
  auditEvents           AuditEvent[]
  dealerPhones          DealerPhone[]
  dealerEmails          DealerEmail[]
  messageDrafts         MessageDraft[]
  importBatches         ImportBatch[]
  duplicateCandidates   DuplicateCandidate[]
  dealerMerges          DealerMerge[]
  interactionEvents     InteractionEvent[]
  sendingIdentities     SendingIdentity[]
  suppressions          Suppression[]
  campaigns             Campaign[]
  outreachSchedules     OutreachSchedule[]
  outreachTemplates     OutreachTemplate[]
  outreachSettings      OutreachSettings?
  products              Product[]
  orders                Order[]
  orderLineItems        OrderLineItem[]
  paymentLedger         PaymentLedgerEntry[]
  syncBatches           SyncBatch[]
  discoveryRuns         DiscoveryRun[]
  leadCandidates        LeadCandidate[]
  whatsappAccount       WhatsAppAccount?
  whatsappTemplates     WhatsAppTemplate[]
  whatsappConversations WhatsAppConversation[]
  callLogs              CallLog[]
  dormancySettings      DormancySettings?
  collectionsSettings   CollectionsSettings?
  collectionCases       CollectionCase[]
  schemes               Scheme[]
  schemeRecipients      SchemeRecipient[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  name           String?
  passwordHash   String?
  role           UserRole
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  assignedDealers Dealer[]     @relation("AssignedSalesman")

  // Email is unique per org, not globally — the same person may exist in two tenants.
  @@unique([organizationId, email])
  // §1.3, belt and braces: the target of every composite (organizationId, id) foreign
  // key below. It is what makes a cross-org `connect` a foreign-key violation in the
  // database, where an application layer cannot forget it.
  @@unique([organizationId, id])
  @@index([organizationId])
}

// Platform operators. NO organizationId — deliberate (§4, §9A).
// Separate table, separate login route (/admin/auth/*), separate session type.
model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  role          AdminRole
  mfaEnabled    Boolean   @default(false)
  // Per-admin TOTP secret, AES-256-GCM encrypted at rest with a key derived from
  // ADMIN_MFA_KEY (core/platform-admin/totp.ts). Stored rather than derived so one
  // admin's factor can be rotated without resetting everyone's, and so a database
  // dump alone yields no working second factors.
  mfaSecret     String?
  // Last TOTP step this admin has spent (finding 11). The replay guard used to be a
  // module-level Map: a deploy or crash inside a code's 90-second window reopened it,
  // and a second API replica never shared it. On the row it survives both.
  mfaLastStep   Int?
  mfaEnrolledAt DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
}

model Dealer {
  id                String  @id @default(cuid())
  organizationId    String
  businessName      String
  contactPersonName String?
  // Internal-only, never sent to a dealer or read by drafting — a rep's own notes.
  // No §1.4 concern: this text never becomes part of an outbound message.
  notes             String?

  region           String?
  city             String?
  state            String?
  businessCategory String?

  source        DealerSource
  pipelineStage PipelineStage @default(NEW)

  assignedSalesmanId String?
  dedupeKey          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id])
  // Composite on purpose (§1.3): a salesman can only ever be a user of THIS dealer's
  // org, enforced by the foreign key, not by remembering to filter.
  assignedSalesman     User?                 @relation("AssignedSalesman", fields: [organizationId, assignedSalesmanId], references: [organizationId, id], onUpdate: Restrict)
  consentLogs          ConsentLog[]
  phones               DealerPhone[]
  emails               DealerEmail[]
  messageDrafts        MessageDraft[]
  duplicateCandidates  DuplicateCandidate[]
  mergesAsSurvivor     DealerMerge[]         @relation("MergeSurvivor")
  mergesAsMerged       DealerMerge[]         @relation("MergeMerged")
  interactionEvents    InteractionEvent[]
  orders               Order[]
  paymentLedger        PaymentLedgerEntry[]
  whatsappConversation WhatsAppConversation?
  callLogs             CallLog[]
  collectionCase       CollectionCase?
  schemeRecipients     SchemeRecipient[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, pipelineStage])
  @@index([organizationId, dedupeKey])
}

// Split out of Dealer rather than stored as Json: §5.1 dedup matches on exact phoneE164
// as its highest-priority rule, which needs a real index. organizationId is carried here
// too so the tenancy guard (§1.3) can scope it like every other table.
model DealerPhone {
  id             String  @id @default(cuid())
  organizationId String
  dealerId       String
  raw            String
  e164           String?
  valid          Boolean @default(false)
  isPrimary      Boolean @default(false)
  isWhatsapp     Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id])
  dealer       Dealer       @relation(fields: [organizationId, dealerId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId])
  @@index([organizationId, e164])
  @@index([dealerId])
}

model DealerEmail {
  id                 String                  @id @default(cuid())
  organizationId     String
  dealerId           String
  address            String
  verificationStatus EmailVerificationStatus @default(UNVERIFIED)
  isPrimary          Boolean                 @default(false)

  organization Organization @relation(fields: [organizationId], references: [id])
  dealer       Dealer       @relation(fields: [organizationId, dealerId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId])
  @@index([organizationId, address])
  @@index([dealerId])
}

// APPEND-ONLY. Never updated, never deleted — this is the DPDP audit trail (§1.6, §4).
// Current consent = most recent row per (dealerId, channel). Channels are independent:
// an email opt-out must never suppress WhatsApp.
model ConsentLog {
  id             String         @id @default(cuid())
  organizationId String
  dealerId       String
  channel        ConsentChannel
  state          ConsentState
  source         ConsentSource
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  dealer       Dealer       @relation(fields: [organizationId, dealerId], references: [organizationId, id], onUpdate: Restrict)

  @@index([organizationId])
  @@index([dealerId, channel, createdAt])
}

// Immutable (§4).
model AuditEvent {
  // Nullable: a platform-wide admin action (§9A.3) belongs to no single org.
  // For VIEWED_ORG_DATA this is the org whose data was viewed.
  organizationId String?
  id             String    @id @default(cuid())
  actorType      ActorType
  actorId        String?
  entityType     String
  entityId       String
  action         String
  metadata       Json?
  createdAt      DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}

// ---------------------------------------------------------------------------
// §11 step 2 — Approval Queue + drafting, and M1 import/dedup (§5.1)
// Relations to Dealer are composite (organizationId, id) like every other
// child table, so a cross-org reference is a foreign-key violation (§1.3).
// ---------------------------------------------------------------------------

enum DraftStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_SENT
  EDITED_AND_SENT
}

// The AI output boundary (§1.4, §1.5). Every AI-generated outbound message
// passes through here before it can become an InteractionEvent.
model MessageDraft {
  id             String @id @default(cuid())
  organizationId String
  dealerId       String
  sourceModule   String

  subject                String   @default("")
  draftText              String
  bodyHtml               String?
  // Free-form extra recipients, set when a human composes a one-off message.
  ccEmails               String[] @default([])
  bccEmails              String[] @default([])
  // §1.4: the DB-sourced numbers, injected as typed variables. The model never
  // sees a free-text slot where a number could be invented.
  templateVariables      Json     @default("{}")
  containsFinancialTerms Boolean  @default(false)
  requiresApproval       Boolean  @default(true)

  status           DraftStatus @default(PENDING)
  approvedByUserId String?
  autoSendRuleId   String?
  sentAt           DateTime?
  // Why the last send attempt failed, and how many have been tried. An APPROVED
  // draft with a lastSendError is the retry queue — before this existed a failed
  // send left the row APPROVED and indistinguishable from one awaiting dispatch,
  // so nothing could ever retry it.
  lastSendError    String?
  sendAttempts     Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  dealer       Dealer       @relation(fields: [organizationId, dealerId], references: [organizationId, id], onUpdate: Restrict)

  @@index([organizationId, status])
  @@index([organizationId, dealerId])
}

enum ImportStatus {
  MAPPING
  PROCESSING
  COMPLETED
  FAILED
}

// §5.1 — `source` is mandatory per import batch, so it lives here, not per row.
model ImportBatch {
  id             String       @id @default(cuid())
  organizationId String
  filename       String
  source         DealerSource
  columnMapping  Json         @default("{}")
  status         ImportStatus @default(MAPPING)

  rowCount       Int @default(0)
  createdCount   Int @default(0)
  duplicateCount Int @default(0)
  invalidCount   Int @default(0)

  createdByUserId String?
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?
  error           String?

  organization Organization         @relation(fields: [organizationId], references: [id])
  candidates   DuplicateCandidate[]

  // Every child relation in this file is composite (organizationId, id) so that a
  // cross-org reference is a foreign-key violation (§1.3). This unique is what lets
  // DuplicateCandidate.importBatch be one too.
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
}

enum MatchReason {
  PHONE_E164
  EMAIL
  FUZZY_NAME_CITY
}

enum CandidateStatus {
  PENDING
  MERGED
  REJECTED
}

// §5.1/§10.1: fuzzy matches are NEVER auto-merged. They land here for a human.
model DuplicateCandidate {
  id              String  @id @default(cuid())
  organizationId  String
  importBatchId   String?
  matchedDealerId String

  incomingPayload Json
  matchReason     MatchReason
  matchScore      Float?
  status          CandidateStatus @default(PENDING)

  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id])
  matchedDealer Dealer       @relation(fields: [organizationId, matchedDealerId], references: [organizationId, id], onUpdate: Restrict)
  importBatch   ImportBatch? @relation(fields: [organizationId, importBatchId], references: [organizationId, id], onUpdate: Restrict)

  @@index([organizationId, status])
}

// §5.1/§10.1: "merges are logged as reversible operations". `snapshot` holds
// enough of the merged dealer to put it back; a wrong merge silently corrupts
// two businesses' order and payment history, so reversal is not optional.
model DealerMerge {
  id                String @id @default(cuid())
  organizationId    String
  survivingDealerId String
  mergedDealerId    String

  snapshot        Json
  reversedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id])
  // Composite like every other dealer reference: the last place a dealer id could
  // live without a database-level org check (§1.3). Both dealers survive a merge —
  // the merged one is parked at INVALID, never deleted — so an FK is safe here.
  survivingDealer Dealer       @relation("MergeSurvivor", fields: [organizationId, survivingDealerId], references: [organizationId, id], onUpdate: Restrict)
  mergedDealer    Dealer       @relation("MergeMerged", fields: [organizationId, mergedDealerId], references: [organizationId, id], onUpdate: Restrict)

  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// §11 step 3 — InteractionEvent + webhook ingestion, and M2's sending tables
// ---------------------------------------------------------------------------

enum InteractionDirection {
  OUTBOUND
  INBOUND
}

enum InteractionStatus {
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  FAILED
  COMPLAINED
}

// Every touch, every channel, one table (§4). This is what makes warm-routing
// (§7) a real query filter rather than a manual export.
model InteractionEvent {
  id             String @id @default(cuid())
  organizationId String
  dealerId       String

  channel   ConsentChannel
  direction InteractionDirection

  campaignId        String?
  messageDraftId    String?
  providerMessageId String?

  status    InteractionStatus
  // The rendered text actually sent — you must be able to answer
  // "what exactly did we send this dealer?" (§4). Subject is part of that answer.
  subject   String            @default("")
  body      String
  toAddress String            @default("")
  // Provider/transport failure text for a FAILED row, so the Sent view can say why
  // instead of showing a bare red badge.
  errorText String?
  createdAt DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  dealer       Dealer       @relation(fields: [organizationId, dealerId], references: [organizationId, id], onUpdate: Restrict)

  @@index([organizationId, dealerId, createdAt])
  @@index([organizationId, providerMessageId])
}

enum DomainVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

// §6: never the org's primary business domain. Warmup ramp is per identity.
model SendingIdentity {
  id                 String                   @id @default(cuid())
  organizationId     String
  domain             String
  provider           String
  // Who the mail appears to come from: `"<fromName>" <fromLocalPart@domain>`.
  // Both were hardcoded ("sales@" + no display name) — a real person's name in
  // the From line measurably outperforms a role address on cold outreach.
  fromName           String                   @default("")
  fromLocalPart      String                   @default("sales")
  replyToAddress     String?
  verificationStatus DomainVerificationStatus @default(UNVERIFIED)
  dkimRecords        Json                     @default("[]")
  warmupStartedAt    DateTime?
  currentDailyLimit  Int                      @default(20)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, domain])
  @@index([organizationId])
}

// §4: scoped per organization. An opt-out from one distributor must not
// suppress that contact for another.
model Suppression {
  id             String   @id @default(cuid())
  organizationId String
  email          String?
  phoneE164      String?
  reason         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, email])
  @@index([organizationId, phoneE164])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  channel        ConsentChannel
  name           String
  status         CampaignStatus @default(DRAFT)
  segmentFilter  Json           @default("{}")
  templateId     String?
  scheduledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
}

// §8 idempotency. Deliberately has NO organizationId: a webhook is received
// before any org context exists, and the HTTP handler only persists and
// enqueues. The org is resolved during async processing, and the
// InteractionEvent that results IS org-scoped. Must be listed explicitly in
// tenancy.ts's exemptions — never inferred from the absent column.
model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  error           String?

  @@unique([provider, providerEventId])
  @@index([processedAt])
}

// ---------------------------------------------------------------------------
// Cold-outreach scheduling and batching (§5.2 extension). Multiple schedules per
// org allowed — e.g. one segment daily, another weekly. Each is a BullMQ repeatable
// job under the hood; this table is the durable record the job registration is
// rebuilt from at boot (BullMQ's own repeat registry does not survive a Redis flush,
// this table does).
// ---------------------------------------------------------------------------
model OutreachSchedule {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  enabled        Boolean @default(true)

  // Exactly one of these two is set — enforced in schedule.service.ts, not a DB
  // constraint (matches how "source is mandatory" etc. are enforced elsewhere in
  // this codebase: at the service layer, not fought into Prisma's migration DSL).
  //   cronExpression set  -> recurring (BullMQ repeatable job)
  //   scheduledAt set     -> exactly once, at that moment (BullMQ delayed job)
  // Standard 5-field cron ("0 9 * * *" = daily at 9am). Validated by BullMQ at
  // registration time, not re-validated here — one parser, not two.
  cronExpression String?
  scheduledAt    DateTime?

  // Caps this run the same way a manual "send N now" would (see runColdOutreach).
  // Null = no extra cap beyond the daily send limit already enforced (§6).
  maxDealersPerRun Int?

  // Same shape as the manual run's segment filter — city/state/businessCategory/
  // source/pipelineStage. {} = every eligible NEW dealer, matching today's default.
  segmentFilter Json @default("{}")

  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastRunAt       DateTime?
  // Set when the firing that produced lastRunAt failed (e.g. no sending identity,
  // no API key configured), cleared on a successful firing. Without this a failed
  // one-time schedule looked identical to one that had never run — BullMQ itself
  // does not retry by default, so a failed firing is otherwise a silent dead end.
  lastError       String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Editable cold-outreach wording. Exactly one active row per org — cold-draft.service
// falls back to its own hardcoded default when none exists, so this table being empty
// is a valid, safe state, not an error. bodyText is validated through the same
// template()/assertNoDigits path (§1.4) as the hardcoded default before it is ever
// saved — a business owner editing wording is not a loophole for a free-typed number
// any more than a hand-written skeleton in code is.
// ---------------------------------------------------------------------------
model OutreachTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  // The subject line. Was hardcoded to one string for every email the app ever
  // sent, which is both unusable and the single strongest spam signal a cold
  // sender can emit. Supports the same {{placeholders}} the body does.
  subject        String   @default("")
  bodyText       String
  // Optional HTML alternative. Null = send text only, which is what cold outreach
  // generally should do anyway (a plain-looking first-touch mail lands better).
  bodyHtml       String?
  // false = render this template deterministically and never show it to the model.
  // §1.4 is satisfied trivially in that mode (the AI writes nothing at all), which
  // is what lets a human-authored template contain literal digits — "24x7",
  // "Since 1995", a GST number — that the AI path must still refuse to emit.
  useAi          Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

/**
 * Per-organization outbound settings (§12.6, §6). One row per org.
 * `throttleEnabled = false` means "do not impose an application-level cap" — the
 * only remaining limits are the provider's own, enforced by paced dispatch rather
 * than a daily ceiling. The warmup ramp is likewise opt-out: it protects a brand
 * new domain, but an org sending from an already-warm domain should not be held
 * to 20/day because this app assumed it must be new.
 */
model OutreachSettings {
  id             String @id @default(cuid())
  organizationId String @unique

  throttleEnabled   Boolean @default(true)
  warmupEnabled     Boolean @default(true)
  /**
   * Applies only while throttleEnabled. 0 = unlimited.
   */
  dailyLimit        Int     @default(50)
  /**
   * Paced dispatch, always applied — this is the provider's rate limit, not ours.
   * Resend allows 2 requests/second; 500ms keeps us just inside it.
   */
  minSendIntervalMs Int     @default(500)

  emailPaused        Boolean @default(false)
  // §12.6 for M0: one switch pauses every discovery run for this org. Crawling is
  // outward-facing — if the User-Agent is annoying someone, the answer is a pause, not a deploy.
  discoveryPaused    Boolean @default(false)
  // §12.6 for WhatsApp: pauses every outbound WhatsApp message for this org.
  whatsappPaused     Boolean @default(false)
  // Meta enforces its own tiered limits; this is OUR ceiling under them. 0 = unlimited.
  whatsappDailyLimit Int     @default(250)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

// ---------------------------------------------------------------------------
// Order & payment sync (§5.5) — shared infrastructure for M5/M6/M7/M8.
// v1 is CSV/XLSX import regardless of the accounting system (§16.1).
// ---------------------------------------------------------------------------

enum OrderSource {
  CSV_IMPORT
  ORDERING_BOT
  MANUAL
  ACCOUNTING_SYNC
}

// Derived from days overdue, never hand-set (§5.8). CURRENT covers "not yet due" and
// "under 30 days late"; D30/D60 are 30-59 / 60-89 days late; D90_PLUS is 90+.
enum AgeingBucket {
  CURRENT
  D30
  D60
  D90_PLUS
}

enum SyncKind {
  ORDERS
  PAYMENTS
  PRODUCTS
}

enum SyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  sku            String
  name           String
  category       String?
  unitPrice      Decimal  @db.Decimal(14, 2)
  imageUrl       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, sku])
  @@index([organizationId])
}

model Order {
  id             String      @id @default(cuid())
  organizationId String
  dealerId       String
  // The accounting system's own voucher/invoice number. What makes a re-import
  // idempotent — the same file twice must not double a dealer's order history.
  externalRef    String?
  orderDate      DateTime
  totalValue     Decimal     @db.Decimal(14, 2)
  source         OrderSource
  // Written by the M6 attribution rule (dealer targeted + date range + product overlap).
  schemeId       String?
  syncBatchId    String?
  createdAt      DateTime    @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id])
  dealer       Dealer          @relation(fields: [organizationId, dealerId], references: [organizationId, id], onUpdate: Restrict)
  lineItems    OrderLineItem[]
  scheme       Scheme?         @relation(fields: [schemeId], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@unique([organizationId, externalRef])
  @@index([schemeId])
  @@index([organizationId, dealerId, orderDate])
  @@index([organizationId, orderDate])
}

model OrderLineItem {
  id             String  @id @default(cuid())
  organizationId String
  orderId        String
  sku            String
  productName    String
  quantity       Decimal @db.Decimal(14, 3)
  unitPrice      Decimal @db.Decimal(14, 2)
  lineTotal      Decimal @db.Decimal(14, 2)

  organization Organization @relation(fields: [organizationId], references: [id])
  order        Order        @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId])
  @@index([orderId])
}

model PaymentLedgerEntry {
  id             String       @id @default(cuid())
  organizationId String
  dealerId       String
  invoiceRef     String
  amount         Decimal      @db.Decimal(14, 2)
  dueDate        DateTime
  paidAmount     Decimal      @default(0) @db.Decimal(14, 2)
  paidDate       DateTime?
  ageingBucket   AgeingBucket @default(CURRENT)
  // Load-bearing (§10.4): collections refuses to send when this is stale.
  lastSyncedAt   DateTime
  syncBatchId    String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  dealer       Dealer       @relation(fields: [organizationId, dealerId], references: [organizationId, id], onUpdate: Restrict)

  @@unique([organizationId, invoiceRef])
  @@index([organizationId, dealerId])
  @@index([organizationId, ageingBucket])
}

// One import run. The latest COMPLETED row per kind IS the "data freshness"
// indicator (§14) — no separate freshness table to drift out of sync with it.
model SyncBatch {
  id              String     @id @default(cuid())
  organizationId  String
  kind            SyncKind
  filename        String
  status          SyncStatus @default(RUNNING)
  rowCount        Int        @default(0)
  createdCount    Int        @default(0)
  updatedCount    Int        @default(0)
  // Rows whose dealer could not be matched EXACTLY. Never fuzzy-matched: attaching an
  // invoice to the wrong business corrupts two payment histories (§5.1's reasoning).
  unmatchedCount  Int        @default(0)
  invalidCount    Int        @default(0)
  errors          Json       @default("[]")
  createdByUserId String?
  startedAt       DateTime   @default(now())
  finishedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, kind, finishedAt])
}

// ---------------------------------------------------------------------------
// M0 — lead discovery (§5.0). Finds businesses not on any list yet. Output is a
// LeadCandidate in a review queue — NEVER a Dealer directly.
// ---------------------------------------------------------------------------

enum DiscoveryMethod {
  PLACES_API
  REGISTRY
  URL_EXTRACT
  FILE_EXTRACT
}

enum DiscoveryRunStatus {
  RUNNING
  COMPLETED
  FAILED
  // An OUTCOME, not an error: the system declined to fetch. See RefusalReason.
  REFUSED
}

enum RefusalReason {
  ROBOTS_DISALLOWED
  BLOCKLISTED_DOMAIN
  LOGIN_WALL
  BLOCKED_BY_SITE
  // Not in the design doc's list: fetching a private/loopback address from the server
  // is SSRF, refused before any request leaves.
  NON_PUBLIC_ADDRESS
}

enum LeadDedupeStatus {
  UNIQUE
  POSSIBLE_DUPLICATE
  CONFIRMED_DUPLICATE
}

enum LeadStatus {
  PENDING
  APPROVED
  REJECTED
  DUPLICATE
}

model DiscoveryRun {
  id                String             @id @default(cuid())
  organizationId    String
  method            DiscoveryMethod
  query             Json               @default("{}")
  status            DiscoveryRunStatus @default(RUNNING)
  refusalReason     RefusalReason?
  resultCount       Int                @default(0)
  costPaise         Int                @default(0)
  triggeredByUserId String?
  startedAt         DateTime           @default(now())
  finishedAt        DateTime?
  error             String?
  // What actually came back, kept so a human can see why a run found nothing (a JS-only
  // page, a page with no listings). Capped by the service — not a shadow copy of a site.
  rawExcerpt        String?

  organization Organization    @relation(fields: [organizationId], references: [id])
  candidates   LeadCandidate[]

  @@unique([organizationId, id])
  @@index([organizationId, startedAt])
}

model LeadCandidate {
  id                String           @id @default(cuid())
  organizationId    String
  discoveryRunId    String
  businessName      String
  contactPersonName String?
  rawPhones         String[]         @default([])
  rawEmails         String[]         @default([])
  address           String?
  city              String?
  state             String?
  category          String?
  // Provenance. Never null (§16.2): "where did we get this person's number" must always
  // have an answer, because most dealers are sole proprietors and the business phone is
  // the owner's personal mobile (DPDP).
  sourceUrl         String
  capturedAt        DateTime
  rawPayload        Json             @default("{}")
  dedupeStatus      LeadDedupeStatus @default(UNIQUE)
  matchedDealerId   String?
  matchScore        Float?
  status            LeadStatus       @default(PENDING)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  promotedDealerId  String?
  createdAt         DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  run          DiscoveryRun @relation(fields: [organizationId, discoveryRunId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId, status])
  @@index([organizationId, discoveryRunId])
}

// ---------------------------------------------------------------------------
// M3 — WhatsApp (§5.3, §7). Official Meta Cloud API only (§1.1). Warm channel only
// (§1.2): a dealer enters WhatsApp outreach only after real engagement.
// ---------------------------------------------------------------------------

enum WhatsAppTemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum WhatsAppTemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

// Deterministic conversation state (§5.3) — a state machine, never a model decision.
enum ConversationState {
  IDLE
  CATALOG
  PRICING
  NEGOTIATION
  NOT_INTERESTED
  HUMAN
}

// One row per organization: which WhatsApp Business number is theirs. This is what an
// inbound webhook is routed by — it arrives carrying only the business phone-number id,
// so the org has to be discovered from it before any tenant context exists.
model WhatsAppAccount {
  id                        String   @id @default(cuid())
  organizationId            String   @unique
  phoneNumberId             String   @unique
  wabaId                    String   @unique
  displayPhone              String?
  // Last quality signal Meta sent (FLAGGED / DOWNGRADE / UPGRADE / ONBOARDING) and the
  // messaging tier it reported. Recorded, not interpreted, beyond the pause below.
  qualityEvent              String?
  messagingTier             String?
  // §7: auto-paused on a quality drop. Stops BROADCASTS (marketing templates) only —
  // replies inside a live session still go out. A human resumes it, never a timer.
  broadcastsPausedByQuality Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

model WhatsAppTemplate {
  id              String                   @id @default(cuid())
  organizationId  String
  // Meta's name rules: lowercase letters, digits, underscore.
  name            String
  language        String                   @default("en")
  category        WhatsAppTemplateCategory
  // Body with Meta-style {{1}} {{2}} placeholders. The template library IS the content
  // (§5.3): there is no model-written WhatsApp text, so §1.4 reduces to substituting
  // database values into approved wording.
  bodyText        String
  // Which dealer field feeds {{1}}, {{2}}… in order.
  paramKeys       String[]                 @default([])
  status          WhatsAppTemplateStatus   @default(DRAFT)
  metaTemplateId  String?
  rejectionReason String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name, language])
  @@index([organizationId, status])
}

model WhatsAppConversation {
  id               String            @id @default(cuid())
  organizationId   String
  dealerId         String
  phoneE164        String
  state            ConversationState @default(IDLE)
  // §7: freeform is allowed only while this is in the future — 24h from the dealer's
  // last inbound message. Outside it, only an approved template may go out.
  sessionExpiresAt DateTime?
  lastInboundAt    DateTime?
  needsHuman       Boolean           @default(false)
  humanReason      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  dealer       Dealer       @relation(fields: [organizationId, dealerId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([organizationId, dealerId])
  @@index([organizationId, needsHuman])
}

// ---------------------------------------------------------------------------
// M4 — calling (§5.4). Human-initiated: a person makes the call, the system compiles the
// brief beforehand and records the outcome after. No dialer, no voice API (§17 Phase 4).
// ---------------------------------------------------------------------------

enum CallOutcome {
  SPOKE_INTERESTED
  SPOKE_CALL_BACK
  SPOKE_NOT_INTERESTED
  ONBOARDED
  NO_ANSWER
  WRONG_NUMBER
  DO_NOT_CALL
}

model CallLog {
  id              String      @id @default(cuid())
  organizationId  String
  dealerId        String
  calledByUserId  String?
  phoneE164       String?
  outcome         CallOutcome
  notes           String?
  durationSeconds Int?
  calledAt        DateTime    @default(now())
  followUpAt      DateTime?
  followUpDone    Boolean     @default(false)
  createdAt       DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  dealer       Dealer       @relation(fields: [organizationId, dealerId], references: [organizationId, id], onUpdate: Restrict)

  @@index([organizationId, dealerId, calledAt])
  @@index([organizationId, followUpAt])
}

// ---------------------------------------------------------------------------
// M5 — dormancy & reactivation (§5.6). Deterministic thresholds, not a model's call
// (§1.5): ACTIVE → DORMANT after N days without an order; a new order closes the loop.
// ---------------------------------------------------------------------------

model DormancySettings {
  id                    String    @id @default(cuid())
  organizationId        String    @unique
  // Off until the owner turns it on: nothing should start emailing dormant dealers because
  // a migration ran.
  enabled               Boolean   @default(false)
  // §5.6: "no order in N days (configurable, default 30)".
  thresholdDays         Int       @default(30)
  // §5.6: a nudge auto-sends only when the dealer's average order value is BELOW this;
  // null means every nudge waits for a person. A higher-value dealer's relationship is the
  // one worth a human glance before anything goes out.
  autoSendBelowAov      Decimal?  @db.Decimal(14, 2)
  // A reactivation counts as "after our nudge" if the nudge went out within this many days
  // before the order — the attribution the case study (§15) needs.
  attributionWindowDays Int       @default(30)
  lastScanAt            DateTime?
  lastScanSummary       Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

// ---------------------------------------------------------------------------
// M7 — collections (§5.8). The escalation ladder (gentle → firm → a person's call) is a
// deterministic state machine driven by days overdue, never an AI decision (§1.5). The AI
// writes only wording; every figure is injected from the ledger (§1.4).
// ---------------------------------------------------------------------------

enum EscalationLevel {
  NONE
  GENTLE
  FIRM
  // The final rung: a person calls. Never automated (§5.8).
  HUMAN
}

model CollectionsSettings {
  id                   String    @id @default(cuid())
  organizationId       String    @unique
  // Off until the owner turns it on — nothing should start chasing dealers for money
  // because a migration ran.
  enabled              Boolean   @default(false)
  // Days overdue at which each rung starts. Must be strictly increasing.
  gentleAfterDays      Int       @default(3)
  firmAfterDays        Int       @default(30)
  humanAfterDays       Int       @default(60)
  // At the same level, no more than one reminder per this many days.
  reminderIntervalDays Int       @default(7)
  // §10.4: an invoice last seen in a sync older than this is not chased — the ledger may
  // have moved on (paid, credited) since. Stale data must never produce a payment demand.
  freshnessWindowHours Int       @default(72)
  lastRunAt            DateTime?
  lastRunSummary       Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

// One row per dealer being chased: where they are on the ladder and what happened last.
model CollectionCase {
  id                String           @id @default(cuid())
  organizationId    String
  dealerId          String
  level             EscalationLevel  @default(NONE)
  oldestDaysOverdue Int              @default(0)
  outstanding       Decimal          @default(0) @db.Decimal(14, 2)
  overdueInvoices   Int              @default(0)
  lastReminderAt    DateTime?
  lastReminderLevel EscalationLevel?
  // A person should call. Feeds the call queue (M4).
  needsCall         Boolean          @default(false)
  callReason        String?
  // When a person last reached them about this — re-flagging waits out the interval.
  handledAt         DateTime?
  updatedAt         DateTime         @updatedAt
  createdAt         DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  dealer       Dealer       @relation(fields: [organizationId, dealerId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([organizationId, dealerId])
  @@index([organizationId, level])
  @@index([organizationId, needsCall])
}

// ---- M6 schemes (§5.7) ----------------------------------------------------------------

enum SchemeStatus {
  DRAFT
  ACTIVE
  ENDED
}

// A trade scheme: terms the owner wrote, a set of products, a validity window, and a
// deterministic rule choosing which dealers it is aimed at. Its terms are financial
// commitments, so every message about it goes to the approval queue (§5.7).
model Scheme {
  id                   String       @id @default(cuid())
  organizationId       String
  name                 String
  description          String?
  // Verbatim, as the owner wrote it ("Buy 10 cases, get 1 free"). Injected into messages
  // as a database string — the model never restates or computes it (§1.4).
  terms                String
  // Product.id values. Attribution matches order lines on the SKUs of these.
  applicableProductIds String[]
  validFrom            DateTime
  validTo              DateTime
  // { categories?, states?, cities?, stages?, boughtSchemeProductsWithinDays? } — see modules/schemes/rules.ts
  targetSegmentRule    Json         @default("{}")
  status               SchemeStatus @default(DRAFT)
  activatedAt          DateTime?
  campaignId           String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  recipients   SchemeRecipient[]
  orders       Order[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
}

// Who the scheme was aimed at, snapshotted at activation: the segment is a function of
// purchase history, which moves, and attribution must not shift under a finished scheme.
model SchemeRecipient {
  id             String   @id @default(cuid())
  organizationId String
  schemeId       String
  dealerId       String
  // The MessageDraft announcing it, once drafted. One per dealer per scheme.
  draftId        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  scheme       Scheme       @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  dealer       Dealer       @relation(fields: [organizationId, dealerId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([schemeId, dealerId])
  @@index([organizationId, dealerId])
}
