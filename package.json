{
  "name": "dealeros",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node --env-file=.env apps/api/scripts/migrate.mjs migrate dev",
    "prisma:deploy": "node --env-file-if-exists=.env apps/api/scripts/migrate.mjs migrate deploy",
    "ensure-app-role": "node --env-file-if-exists=.env apps/api/scripts/ensure-app-role.mjs",
    "test": "pnpm --filter @dealeros/api test",
    "db:seed": "pnpm --filter @dealeros/api db:seed"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "ignoredBuiltDependencies": ["msgpackr-extract"]
  }
}
